@article{Bellman1967,
abstract = {This chapter introduces the reader to an entirely different approach to the treatment of control processes. It is based on the theory of dynamic programming, a mathematical abstraction and extension of the fundamental engineering concept of feedback control. The aim is to make the concepts and methodology as apparent and plausible as possible. Consequently, the chapter first proceeds in a formal fashion and then uses the preceding results to establish the validity of the formulas obtained for the cases considered in this chapter. The chapter also discusses the topic of discrete control processes. The formalism of the calculus of variations yields an ordinary differential equation, the new formalism confronts with a partial differential equation of unfamiliar type. However, the differential equation was subject to a two-point boundary condition, whereas the partial differential equation has its solution determined by an initial condition. {\textcopyright} 1967, Academic Press, Inc.},
