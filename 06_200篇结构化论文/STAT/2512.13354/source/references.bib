@article{papavasileiouEquationbasedDatadrivenModeling2023,
  title = {Equation-Based and Data-Driven Modeling Strategies for Industrial Coating Processes},
  author = {Papavasileiou, Paris and Koronaki, Eleni D. and Pozzetti, Gabriele and Kathrein, Martin and Czettl, Christoph and Boudouvis, Andreas G. and Bordas, St{\'e}phane P.A.},
  year = {2023},
