@article{heo2024blockchaindatastorage,
  title = {Blockchain {{Data Storage Optimisations}}: {{A Comprehensive Survey}}},
  shorttitle = {Blockchain {{Data Storage Optimisations}}},
  author = {Heo, Jun Wook and Ramachandran, Gowri Sankar and Dorri, Ali and Jurdak, Raja},
