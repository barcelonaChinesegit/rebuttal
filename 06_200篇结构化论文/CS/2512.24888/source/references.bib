@article{taofeek2025fragilebalancenavigating,
  title = {The Fragile Balance: {{Navigating}} Data Privacy, {{AI}} Ethics, and Blockchain Transparency in {{AML}} Enforcement},
  shorttitle = {The {{Fragile Balance}}},
  author = {Taofeek, Adedokun},
  year = 2025,
  month = may,
  abstract = {The accelerating adoption of digital technologies in financial systems has significantly reshaped Anti-Money Laundering (AML) enforcement mechanisms. While artificial intelligence (AI) and blockchain offer powerful tools for detecting illicit financial activity and enhancing transparency, their deployment raises profound ethical and legal concerns. This paper delves into the intricate balance between leveraging these technologies and upholding fundamental principles of data privacy, algorithmic fairness, and institutional accountability. Specifically, it examines how AI-driven surveillance systems can unintentionally reinforce biases or violate individual rights, and how blockchain's immutable and transparent nature can clash with privacy regulations such as the General Data Protection Regulation (GDPR). The analysis includes a review of emerging regulatory frameworks and compliance obligations, as well as case studies that illustrate the operational tensions between innovation and oversight. The paper also explores how institutions can design governance models that ensure ethical AI use, incorporate privacy-by-design principles in blockchain applications, and foster interjurisdictional collaboration in a fragmented regulatory landscape. In doing so, it argues for a more holistic and interdisciplinary approach to AML enforcement-one that bridges technological capability with legal and ethical safeguards, ensuring that the fight against financial crime does not compromise civil liberties or public trust.},
  file = {/Users/c0mm4nd/Zotero/storage/5Q55FZCY/Taofeek - 2025 - The fragile balance Navigating data privacy, AI ethics, and blockchain transparency in AML enforcem.pdf}
}

@incollection{tiwari2025understandingevolvinglandscape,
  title = {Understanding the Evolving Landscape of Financial Crimes and Cybercrimes Using Cryptocurrencies},
  author = {Tiwari, Milind and Zhou, You},
  year = 2025,
  month = sep,
  pages = {1--30},
  doi = {10.4018/979-8-3373-0675-9.ch001},
  abstract = {This chapter examines the emerging trends between cryptocurrencies, financial crimes, and cybercrimes. While cryptocurrencies promote transaction efficiency, the decentralized and anonymous features give rise to ample opportunities for financial crimes, such as Initial Coin Offering (ICO) fraud, cross-chain money laundering, and crypto-enabled financial crimes (e.g., crypto thefts). Cryptocurrencies also facilitate the avenue of cybercrime through cyber-dependent crimes (e.g., crypto ransomware), cyber-enabled crimes (e.g., crypto scams), and online illicit cryptomarkets. Along with financial loss, victims' psychological and social harms are further exacerbated by forensic complexities. Networked approaches are recommended to prevent and mitigate the harms, which are composed of nodal and interoperable engagement between criminal justice systems, financial institutions, and technological companies. The findings underscore the importance of ongoing research and adaptive regulations against evolving conundrums posed by cryptocurrency-related financial crimes.},
  isbn = {979-8-3373-0675-9}
}

