\RequirePackage{xparse}
\RequirePackage{enumitem}

% https://tex.stackexchange.com/a/78582
\makeatletter
\NewDocumentCommand\proofEl{m o}{\begingroup\refstepcounter{equation}\IfValueT{#1}{\label{#2}}#1~\@eqnnum\endgroup}
\makeatother

% https://tex.stackexchange.com/a/162307
\NewDocumentCommand\brdr{m m}{\begingroup\setlength\fboxsep{#1}\sbox0{\fbox{#2}}\setlength{\fboxrule}{0pt}\mbox{\kern-\fboxsep\fbox{\unhbox0}\kern-\fboxsep}\endgroup}

\NewDocumentCommand\proofcase{O{}}{\item[\brdr{2pt}{#1}]}
\NewDocumentEnvironment{proofcases}{O{}}{\begin{description}[format=\normalfont\itshape,style=nextline,leftmargin=.4cm,#1]}{\end{description}}
