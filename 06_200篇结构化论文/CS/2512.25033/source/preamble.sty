%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Problem boxes
\newcommand{\problembox}[2]{%
    \par\noindent
    \begin{center}
        \begin{tikzpicture}
            \node[draw=black!20,fill=white,rounded corners,inner sep=2ex]
                (Text) {%
                    \begin{minipage}{.93\textwidth}
                        \begin{tabularx}{\linewidth}{@{\hspace{.1em}} l X @{}}
                            #2
                        \end{tabularx}
                    \end{minipage}%
                };
            \coordinate (x) at (current bounding box.north west);
            \node[draw=white,rectangle,inner sep=3pt,anchor=north west,fill=white]
                at ($(x)+(6pt,.75em)$) {\textsc{#1}};
        \end{tikzpicture}
    \end{center}%
}

\newcommand{\defproblem}[3]{%
    \problembox{#1}{%
        \textbf{Instance:} & #2 \\
        \textbf{Goal:} & #3
    }%
}

