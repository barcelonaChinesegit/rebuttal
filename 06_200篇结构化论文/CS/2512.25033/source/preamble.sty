% Theorem-like environments
\newtheorem{theorem}{Theorem}
\newaliascnt{lemma}{theorem}
\newtheorem{lemma}[lemma]{Lemma}
\aliascntresetthe{lemma}
\newaliascnt{definition}{theorem}
\newtheorem{definition}[definition]{Definition}
\aliascntresetthe{definition}
\newaliascnt{observation}{theorem}
\newtheorem{observation}[observation]{Observation}
\aliascntresetthe{observation}
\theoremstyle{remark}
\newaliascnt{remark}{theorem}
\newtheorem{remark}[remark]{Remark}
\aliascntresetthe{remark}
\theoremstyle{plain}
\newaliascnt{corollary}{theorem}
\newtheorem{corollary}[corollary]{Corollary}
\aliascntresetthe{corollary}
\newaliascnt{claim}{theorem}
\newtheorem{claim}[claim]{Claim}
\aliascntresetthe{claim}
\newtheorem*{claim*}{Claim}

\providecommand{\creflastconjunction}{, and~}
\crefname{claim}{Claim}{Claims}
\crefname{observation}{Observation}{Observations}
\crefname{corollary}{Corollary}{Corollaries}
\crefname{remark}{Remark}{Remarks}

\Crefname{claim}{Claim}{Claims}
\Crefname{observation}{Observation}{Observations}
\Crefname{corollary}{Corollary}{Corollaries}
\Crefname{remark}{Remark}{Remarks}


\newenvironment{claimproof}
{\renewcommand{\qedsymbol}{$\diamond$}\begin{proof}[Proof of the claim]}
{\end{proof}}

