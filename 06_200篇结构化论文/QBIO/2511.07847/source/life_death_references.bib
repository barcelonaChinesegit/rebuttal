@article{barandiaran_norm-establishing_2014,
	title = {Norm-Establishing and Norm-Following in Autonomous Agency},
	volume = {20},
	issn = {1064-5462, 1530-9185},
	url = {https://direct.mit.edu/artl/article/20/1/5-28/2769},
	doi = {10.1162/ARTL_a_00094},
	abstract = {Living agency is subject to a normative dimension (good-bad, adaptive-maladaptive) that is absent from other types of interaction. We review current and historical attempts to naturalize normativity from an organism-centered perspective, identifying two central problems and their solution: (1) How to define the topology of the viability space so as to include a sense of gradation that permits reversible failure, and (2) how to relate both the processes that establish norms and those that result in norm-following behavior. We present a minimal metabolic system that is coupled to a gradient-climbing chemotactic mechanism. Studying the relationship between metabolic dynamics and environmental resource conditions, we identify an emergent viable region and a precarious region where the system tends to die unless environmental conditions change. We introduce the concept of normative field as the change of environmental conditions required to bring the system back to its viable region. Norm-following, or normative action, is defined as the course of behavior whose effect is positively correlated with the normative field. We close with a discussion of the limitations and extensions of our model and some final reflections on the nature of norms and teleology in agency.},
	pages = {5--28},
	number = {1},
	journal = {Artificial Life},
	shortjournal = {Artificial Life},
	author = {Barandiaran, Xabier E. and Egbert, Matthew D.},
	urldate = {2025-11-10},
	date = {2014-01},
	langid = {english},
	file = {Full Text:C\:\\Users\\conno\\Zotero\\storage\\RSMA3G65\\Barandiaran and Egbert - 2014 - Norm-Establishing and Norm-Following in Autonomous Agency.pdf:application/pdf},
    year = {2014},
}

