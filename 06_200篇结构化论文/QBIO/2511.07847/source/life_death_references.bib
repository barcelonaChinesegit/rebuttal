	file = {Full Text: C\:\\Users\\conno\\Zotero\\storage\\3BS5VVKL\\Agmon and Spangler - 2020 - A Multi-Scale Approach to Modeling E. coli Chemotaxis.pdf:application/pdf},
    year = {2020},
}

