eprint = { https://doi.org/10.1080/01431161.2025.2545638
},
abstract = { Pelagic Sargassum in the Atlantic Ocean has increased in biomass and extent since 2011, bringing environmental, health, and economic issues to coastal communities, including those in the Florida Keys, a tourism hub renowned for coral reefs and marine diversity. While Sargassum is regularly monitored using medium resolution satellites, algorithm uncertainties lead to data gaps in nearshore regions (waters within 10 km of the shoreline) precluding the ability to monitor inundation within the Florida Keys National Marine Sanctuary (FKNMS). This study addresses this limitation by using a Res-UNet deep learning model for Sargassum feature extraction from high-resolution images collected by the Sentinel-2 Multi-Spectral Imagers (MSI, 10–60 m). The model achieved an F1 score of 88\% after subpixel coverage adjustment. Notably, 15.7\% of daily detections occur in waters within 10 km of land, where detections using medium resolution satellites are generally unreliable. Additionally, the study examined reported Sargassum temperature anomalies to improve understanding of their ecological impact on the associated microclimate. Using the Thermal Infrared Sensor (TIRS, 100 m) and Operational Land Imager (OLI, 30 m) aboard Landsat 8 and 9 satellites, sea surface temperature differences (ΔSST) between Sargassum mats and surrounding waters ranged from −0.24°C to 0.99°C. After accounting for natural variability and sensor noise, 1–21\% of the daily detected Sargassum mats showed temperature anomalies, with 95\% of those anomalies being positive. Moreover, the temperature anomalies intensified with Sargassum mat density, where 90\% of pixels with at least 45\% Sargassum coverage exhibited anomalies. These findings support the implementation of a high-resolution Sargassum monitoring system for the Florida Keys and provide insights into Sargassum’s thermal influence on the surrounding ecosystem. }
}

