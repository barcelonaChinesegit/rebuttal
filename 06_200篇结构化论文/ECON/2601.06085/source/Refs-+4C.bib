@article{LIANG2022HPAI_H5N6,
title = {Pathogenesis and infection dynamics of high pathogenicity avian influenza virus {(HPAIV)} {H5N6} (clade 2.3.4.4b) in pheasants and onward transmission to chickens},
journal = {Virology},
volume = {577},
pages = {138-148},
year = {2022},
issn = {0042-6822},
doi = {10.1016/j.virol.2022.10.009},
url = {https://www.sciencedirect.com/science/article/pii/S0042682222001854},
author = {Yuan Liang and Charlotte K. Hjulsager and Amanda H. Seekings and Caroline J. Warren and Fabian Z.X. Lean and Alejandro Núñez and Joe James and Saumya S. Thomas and Ashley C. Banyard and Marek J. Slomka and Ian H. Brown and Lars E. Larsen},
keywords = {Avian, Influenza, Game bird, Epidemic, Pheasant, Chicken, Transmission, Pathogenesis, HPAIV},
abstract = {High pathogenicity avian influenza viruses clade 2.3.4.4 H5 have spread among wild birds worldwide during recent years causing annual die-offs among wild birds and outbreaks in poultry in multiple European countries. The outbreaks significantly impact the poultry and game bird sectors. Infected game birds may act as a bridging species potentially enabling spread of virus into commercial and backyard premises. In this study, the pathogenesis and transmission of a HPAIV clade 2.3.4.4b H5N6 virus was investigated in pheasants and chickens. Efficient virus transmission was detected between pheasants over multiple rounds of naïve pheasant introductions and onwards to chickens. Mortality of up to 100\% was observed for both infected pheasants and chickens. Intra-species transmission from chicken to chicken was less efficient. The study confirmed that clade 2.3.4.4b H5N6 HPAIV is highly virulent in pheasants and emphasises the role of pheasants as a bridging host for the infection of commercial poultry.}
}

@article{Nguyen2015SynfuelCurrentStatus,
author = {Nguyen, Van Nhu and Blum, Ludger},
title = {Syngas and Synfuels from H2O and CO2: Current Status},
