@article{Tian2020N2OSources_sinks,
author = {Tian, Hanqin and Xu, Rongting and Canadell, Josep G. and others},
title = {A comprehensive quantification of global nitrous oxide sources and sinks},
journal = {Nature},
volume = {586},
number = {7828},
pages = {248-256},
doi = {10.1038/s41586-020-2780-0},
url = {https://doi.org/10.1038/s41586-020-2780-0},
abstract = {Nitrous oxide (N2O), like carbon dioxide, is a long-lived greenhouse gas that accumulates in the atmosphere. Over the past 150 years, increasing atmospheric N2O concentrations have contributed to stratospheric ozone depletion1 and climate change2, with the current rate of increase estimated at 2 per cent per decade. Existing national inventories do not provide a full picture of N2O emissions, owing to their omission of natural sources and limitations in methodology for attributing anthropogenic sources. Here we present a global N2O inventory that incorporates both natural and anthropogenic sources and accounts for the interaction between nitrogen additions and the biochemical processes that control N2O emissions. We use bottom-up (inventory, statistical extrapolation of flux measurements, process-based land and ocean modelling) and top-down (atmospheric inversion) approaches to provide a comprehensive quantification of global N2O sources and sinks resulting from 21 natural and human sectors between 1980 and 2016. Global N2O emissions were 17.0 (minimum–maximum estimates: 12.2–23.5) teragrams of nitrogen per year (bottom-up) and 16.9 (15.9–17.7) teragrams of nitrogen per year (top-down) between 2007 and 2016. Global human-induced emissions, which are dominated by nitrogen additions to croplands, increased by 30\% over the past four decades to 7.3 (4.2–11.4) teragrams of nitrogen per year. This increase was mainly responsible for the growth in the atmospheric burden. Our findings point to growing N2O emissions in emerging economies—particularly Brazil, China and India. Analysis of process-based model estimates reveals an emerging N2O–climate feedback resulting from interactions between nitrogen additions and climate change. The recent growth in N2O emissions exceeds some of the highest projected emission scenarios3,4, underscoring the urgency to mitigate N2O emissions.},
year = {2020}
}


@misc{Meadows1994LetterToWilliamNordhaus,
   year = {1994},
   author = {Donella  Meadows},
   title = {{Letter to William Nordhaus}},
   abstract = {Dear Professor Nordhaus,  A friend just sent me a copy of your American Scientist article, and  I couldn't suppress a smile as I read it. "There he goes again," I thought. "Asking exactly the right question, a profound question, a question that has crucial implications for public policy -- and then blowing the answer, because of his disciplinary blinders. I wish Bill Nordhaus could be either interesting and not so frustrating, or frustrating and not so interesting, instead of being such a perverse combination of both!"
   Why was your survey sample weighted so outrageously in favor of economists? Why was there only one ecologist, when the integrity and adaptability of ecosystems is the central link between climate and economy? (In my experience, the ecologists are the professional class most worried about the consequences of climate change.) And why did you impose your own discipline's bias on the entire survey by asking to measure consequences through impact on GWP? (Why do economists keep on using that confused measure as if it had some interpretable meaning, something to do with welfare, when their own textbooks point out so clearly that it doesn't? If I had been one of your respondents, I would have estimated the impact of the scenario C as 200-500% of GWP.)
   And yet, with all its faults, your survey was a brilliant idea. Its interesting result is not the respondents' wild numerical guesses about a meaningless indicator, but their verbal comments, some of which you quote in the article. What you have done is start an interdisciplinary dialogue about the deep sources of our certainties and uncertainties -- exactly what is most needed.
   I urge you to continue that job, to do it better, to do it right. I'll do anything I can to support you in the process including ceasing to write you disrespectful letters, if that helps. },
   note={\url{https://archive.org/details/limitstogrowthr00mead} , accessed 2022-06-10 } 
} 

