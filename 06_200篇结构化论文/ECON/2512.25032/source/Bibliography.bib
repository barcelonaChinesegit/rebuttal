  timestamp = {2018-01-12T23:49:11Z},
  number = {6264},
  urldate = {2018-01-12},
  journal = {Science},
  author = {Blumenstock, Joshua and Cadamuro, Gabriel and On, Robert},
  month = nov,
  year = {2015},
  pages = {1073--1076},
  file = {Snapshot:/Users/jonathanroth/Library/Application Support/Zotero/Profiles/rlduhadg.default/zotero/storage/7KQ3GGPG/1073.html:text/html},
