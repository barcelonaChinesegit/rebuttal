@techreport{kahn-lang_promise_2018,
  type = {Working Paper},
  title = {The {{Promise}} and {{Pitfalls}} of {{Differences}}-in-{{Differences}}: {{Reflections}} on `16 and {{Pregnant}}' and {{Other Applications}}},
  shorttitle = {The {{Promise}} and {{Pitfalls}} of {{Differences}}-in-{{Differences}}},
  abstract = {We use the exchange between Kearney/Levine and Jaeger/Joyce/Kaestner on ``16 and Pregnant'' to reexamine the use of DiD as a response to the failure of nature to properly design an experiment for us. We argue that 1) any DiD paper should address why the original levels of the experimental and control groups differed, and why this would not impact trends, 2) the parallel trends argument requires a justification of the chosen functional form and that the use of the interaction coefficients in probit and logit may be justified in some cases, and 3) parallel trends in the period prior to treatment is suggestive of counterfactual parallel trends, but parallel pre-trends is neither necessary nor sufficient for the parallel counterfactual trends condition to hold. Importantly, the purely statistical approach uses pretesting and thus generates the wrong standard errors. Moreover, we underline the dangers of implicitly or explicitly accepting the null hypothesis when failing to reject the absence of a differential pre-trend. \emph{This paper was motivated by two NBER working papers: $<$a href="/papers/w19795"$>$w19795$<$/a$>$ and $<$a href="/papers/w24856"$>$w24856$<$/a$>$.}},
  timestamp = {2018-08-24T14:42:27Z},
  number = {24857},
  institution = {National Bureau of Economic Research},
  author = {Kahn-Lang, Ariella and Lang, Kevin},
  month = jul,
  year = {2018},
  file = {Full Text PDF:/Users/jonathanroth/Library/Application Support/Zotero/Profiles/rlduhadg.default/zotero/storage/2ZH3DWZN/Kahn-Lang and Lang - 2018 - The Promise and Pitfalls of Differences-in-Differe.pdf:application/pdf},
  groups = {EventStudyInference},
