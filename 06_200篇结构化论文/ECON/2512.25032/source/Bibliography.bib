@techreport{wu_gender_2017,
  address = {Rochester, NY},
  type = {SSRN Scholarly Paper},
  title = {Gender {{Stereotyping}} in {{Academia}}: {{Evidence}} from {{Economics Job Market Rumors Forum}}},
  shorttitle = {Gender {{Stereotyping}} in {{Academia}}},
  abstract = {Stereotyping, the process of ascribing characteristics based on group membership, can exaggerate the contrast between in-group and out-group and foster an unwelcoming atmosphere. This paper examines the existence and extent of gender stereotyping on Economics Job Market Rumors, an anonymous online forum with academic and professional purposes.  First, I use a Lasso Logistic model to directly capture the gender stereotyped language. Discussions about women tend to focus more on physical appearance or family information, whereas discussions about men are more on their academic or professional aspects. The topic analysis provides further evidence on this finding from a more aggregate perspective. In addition, I develop an econometric framework to study gender stereotyping in the dynamics of a conversation. I find that there is a significantly stronger deviation from an Academic/Professional focus when there is a prior mention of women; in contrast, the deviation from a Personal/Physical topic is stronger if the prior post is about men rather than women. Last, female economists tend to receive more attention online than their male counterparts, a pattern that further emphasizes the need to reduce stereotyping and maintain an inclusive environment.},
  language = {en},
  timestamp = {2018-01-15T00:21:42Z},
  number = {ID 3051462},
  urldate = {2018-01-15},
  institution = {Social Science Research Network},
  author = {Wu, Alice},
  month = dec,
  year = {2017},
  keywords = {Alice Wu,Gender Stereotyping in Academia: Evidence from Economics Job Market Rumors Forum,SSRN},
  file = {Snapshot:/Users/jonathanroth/Library/Application Support/Zotero/Profiles/rlduhadg.default/zotero/storage/ZUP8PS4D/papers.html:text/html},
  groups = {Sendhil's Course}
