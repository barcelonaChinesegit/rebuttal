  annote = {Comment: 118 pages, 3 tables, 11 figures, includes supplementary appendix. This version corrects some typos in Example 2 of the published version},
  file = {arXiv\:1311.2645 PDF:/Users/jonathanroth/Library/Application Support/Zotero/Profiles/rlduhadg.default/zotero/storage/3KVTS2S5/Belloni et al. - 2013 - Program Evaluation and Causal Inference with High-.pdf:application/pdf;arXiv.org Snapshot:/Users/jonathanroth/Library/Application Support/Zotero/Profiles/rlduhadg.default/zotero/storage/RBF6DWVD/1311.html:text/html},
