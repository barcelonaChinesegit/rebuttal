  issn = {1932-6203},
  doi = {10.1371/journal.pone.0064846},
  abstract = {Understanding the mutual relationships between information flows and social activity in society today is one of the cornerstones of the social sciences. In financial economics, the key issue in this regard is understanding and quantifying how news of all possible types (geopolitical, environmental, social, financial, economic, etc.) affects trading and the pricing of firms in organized stock markets. In this article, we seek to address this issue by performing an analysis of more than 24 million news records provided by Thompson Reuters and of their relationship with trading activity for 206 major stocks in the S\&P US stock index. We show that the whole landscape of news that affects stock price movements can be automatically summarized via simple regularized regressions between trading activity and news information pieces decomposed, with the help of simple topic modeling techniques, into their ``thematic'' features. Using these methods, we are able to estimate and quantify the impacts of news on trading. We introduce network-based visualization techniques to represent the whole landscape of news information associated with a basket of stocks. The examination of the words that are representative of the topic distributions confirms that our method is able to extract the significant pieces of information influencing the stock market. Our results show that one of the most puzzling stylized facts in financial economies, namely that at certain times trading volumes appear to be ``abnormally large,'' can be partially explained by the flow of news. In this sense, our results prove that there is no ``excess trading,'' when restricting to times when news is genuinely novel and provides relevant financial information.},
  language = {en},
  timestamp = {2018-01-14T19:04:32Z},
  number = {6},
  urldate = {2018-01-14},
  journal = {PLOS ONE},
  author = {Hisano, Ryohei and Sornette, Didier and Mizuno, Takayuki and Ohnishi, Takaaki and Watanabe, Tsutomu},
  month = jun,
  year = {2013},
  keywords = {Economic impact analysis,Environmental economics,Finance,Financial markets,Geopolitics,Islands,Semantics,Stock markets},
  pages = {e64846},
  file = {Full Text PDF:/Users/jonathanroth/Library/Application Support/Zotero/Profiles/rlduhadg.default/zotero/storage/ZVKJ48IS/Hisano et al. - 2013 - High Quality Topic Extraction from Business News E.pdf:application/pdf;Snapshot:/Users/jonathanroth/Library/Application Support/Zotero/Profiles/rlduhadg.default/zotero/storage/EN9J6KU9/article.html:text/html},
  groups = {Sendhil's Course}
}

