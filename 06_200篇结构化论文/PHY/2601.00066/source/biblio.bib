abstract = {Abstract:
The basic questions for a self-adaptive solution of nonlinear systems of elliptic and parabolic PDEs by a variable step size/variable order finite difference method on vector computers are discussed. This includes the iterative solution of large linear systems of equations. The design considerations for the FIDISOL program package and for the selection of optimal data structures are outlined and examples which have been computed on different vector computers are presented. A critical discussion of the solution method is followed by some concluding remarks.}
}

@article{SCHONAUER2001473,
title = {How We solve PDEs},
journal = {Journal of Computational and Applied Mathematics},
volume = {131},
number = {1},
pages = {473-492},
year = {2001},
issn = {0377-0427},
doi = {https://doi.org/10.1016/S0377-0427(00)00255-7},
url = {https://www.sciencedirect.com/science/article/pii/S0377042700002557},
author = {Willi Schönauer and Torsten Adolph},
keywords = {Finite difference method, Unstructured grid, Nonlinear PDEs, Mesh refinement, Order control},
abstract = {A finite difference method on an unstructured finite element mesh which we call finite difference element method (FDEM) is presented. The FDEM program package will be a black-box solver for nonlinear systems of elliptic and parabolic PDEs with mesh refinement and automatic control of the consistency order in each space grid point. In this paper we present the solution method (with examples) for 2-D systems of elliptic PDEs.}
}

