@article{SCHONAUER1989279,
title = {Efficient vectorizable PDE solvers},
journal = {Journal of Computational and Applied Mathematics},
volume = {27},
number = {1},
pages = {279-297},
year = {1989},
note = {Special Issue on Parallel Algorithms for Numerical Linear Algebra},
issn = {0377-0427},
doi = {https://doi.org/10.1016/0377-0427(89)90371-3},
url = {https://www.sciencedirect.com/science/article/pii/0377042789903713},
author = {W. Schönauer and R. Wei\ss},
keywords = {Elliptic PDEs, parabolic PDEs, nonlinear PDEs, finite difference method, variable step size/variable order method, self-adaptation, iterative solution of linear systems, vectorization, optimal data structures},
abstract = {The basic questions for a self-adaptive solution of nonlinear systems of elliptic and parabolic PDEs by a variable step size/variable order finite difference method on vector computers are discussed. This includes the iterative solution of large linear systems of equations. The design considerations for the FIDISOL program package and for the selection of optimal data structures are outlined and examples which have been computed on different vector computers are presented. A critical discussion of the solution method is followed by some concluding remarks.}
}
