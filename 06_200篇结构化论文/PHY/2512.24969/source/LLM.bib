@misc{noteL,
note={There are larger scale efforts using universal compression algorithms to estimate the entropy of texts as a function of their length \cite{Takahira2016entropy}. We note that in such experiments the compression algorithm starts with a blank slate and effectively learns  a model as it sees more text, while in LLMs the model is learned in advance. For what we usually think of as the entropy of English the latter is more relevant.}
}

