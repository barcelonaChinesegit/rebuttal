@article{tetraeq,
title = {The tetrahedron equation and the four-simplex equation},
journal = {Physics Letters A},
volume = {134},
number = {4},
pages = {221-228},
year = {1989},
issn = {0375-9601},
doi = {https://doi.org/10.1016/0375-9601(89)90400-3},
url = {https://www.sciencedirect.com/science/article/pii/0375960189904003},
author = {Jean Michel Maillet and Frank Nijhoff},
abstract = {The tetrahedron equation and the four-simplex equation are multidimensional generalizations of the Yang-Baxter or triangle equations. We discuss common features of these members of the family of “simplex equations”. Zamolodchikov's solution of the tetrahedron equation is rewritten in an algebraic form and a generalization of it to the four-simplex case is proposed. Relevance of the simplex equation for the understanding of multidimensional integrability is briefly discussed.}
}
