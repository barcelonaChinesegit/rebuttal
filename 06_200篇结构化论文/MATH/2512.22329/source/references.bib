@misc{Wei2020,
  author        = {Wei, Y. and Chen, Y. and Gao, Q. and Wang, Y.},
  title         = {Infinite series representation of fractional calculus: theory and applications},
  year          = {2020},
  note          = {Preprint, Version 3. arXiv:1901.11134.},
  eprint        = {1901.11134},
  archivePrefix = {arXiv},
  doi           = {10.48550/arXiv.1901.11134}
}
% Yiheng Wei, YangQuan Chen, Qing Gao, and Yong Wang develop a universal framework for infinite series representations of fractional integrals and  derivatives, including a fractional Taylor series expanded at the initial instant or at the current time, encompassing the Riemann--Liouville and  Caputo definitions as well as variable-order fractional calculus. The construction preserves a discrete summation structure indexed by the natural numbers and is applied to numerical approximation schemes via truncation. While conceptually adjacent in its use of fractional Taylor ideas, it does not integrate over the order variable or propose a continuous-order representation of analytic functions, which is the central contribution of my paper.

@article{Weyl1917,
  author  = {Weyl, H.},
  title   = {Bemerkungen zum {Begriff} des {Differentialquotienten} 
             gebrochener {Ordnung}},
  journal = {Vierteljahresschrift der Naturforschenden Gesellschaft 
             in {Z}{\"u}rich},
  volume  = {62},
  pages   = {296--302},
  year    = {1917}
}
% Hermann Weyl introduces a definition of fractional differentiation via Fourier series, applicable to periodic functions, which coincides with the Liouville (Fourier-multiplier) definition in the appropriate function class. The operator is defined spectrally by multiplying Fourier coefficients by $(in)^r$, making it the historical precursor to the modern Fourier-multiplier formulation used in this paper. Cited here to attribute the Liouville (Fourier-multiplier) definition to its original source.

@article{ZitaneTorres2023,
  author  = {Zitane, H. and Torres, D. F. M.},
  title   = {Generalized {Taylor}'s formula for power fractional derivatives},
  journal = {Bol. Soc. Mat. Mex.},
  volume  = {29},
  number  = {3},
  pages   = {Paper No. 68, 14pp},
  year    = {2023},
  doi     = {10.1007/s40590-023-00540-0}
}
% Hanaa Zitane and Delfim F. M. Torres introduce a generalized Taylor formula for a family of power fractional derivatives that encompass several nonsingular-kernel operators, including Mittag--Leffler-type models, as special cases. Their results unify and extend earlier fractional Taylor theorems by constructing discrete expansions based on iterates of a fixed fractional derivative operator. The resulting series retain a natural-number index and generalize classical Taylor polynomials within the chosen operator framework. Although this work broadens the class of fractional operators admitting Taylor-type expansions, it remains fundamentally discrete in derivative order. It does not consider integration over the order parameter nor the spectral continuous-order reconstruction problem studied in my paper. My work differs by integrating derivative data across all real orders r >= 0 and analyzing the resulting reconstruction error as a sum--integral mismatch governed by the Euler--Maclaurin formula.