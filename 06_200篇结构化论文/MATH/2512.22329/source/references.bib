@article{Alquran2023,
  author  = {Alquran, M.},   
  title   = {The amazing fractional {Maclaurin} series for solving different types of fractional mathematical problems that arise in physics and engineering},
  journal = {Part. Differ. Equ. in Appl. Math.},
  volume  = {7},
  pages   = {100506},
  year    = {2023},
  doi     = {10.1016/j.padiff.2023.100506}
}
% Marwan Alquran presents a modern formulation of fractional Maclaurin series using discrete fractional orders and Mittag-Leffler-type closures, with applications to fractional mathematical models arising in physics and engineering. The paper develops explicit series-based representations and emphasizes computational and applied aspects. Although it shares the general goal of extending Maclaurin-type expansions to fractional calculus, the construction remains discrete in the order parameter and series-based.

@article{FernandezBaleanu2018,
  author  = {Fernandez, A. and Baleanu, D.},
  title   = {The mean value theorem and {Taylor}'s theorem for fractional derivatives with {Mittag--Leffler} kernel},
  journal = {Adv. in Differ. Equ.},
  volume  = {2018},
  pages   = {86},
  year    = {2018},
  doi     = {10.1186/s13662-018-1543-9}
}
% Arran Fernandez and Dumitru Baleanu develop mean value and Taylor theorems for the Atangana--Baleanu fractional derivative in Caputo sense (ABC), which uses a nonsingular Mittag--Leffler kernel. Their Taylor expansion replaces integer derivatives with iterates of a fixed fractional derivative operator of order alpha, producing a discrete series indexed by the natural numbers. The work extends fractional Taylor theory into the nonsingular-kernel framework and demonstrates that Mittag--Leffler-based operators admit classical-style Taylor structures. However, the construction remains discrete in the iterate index and does not integrate over derivative order. In contrast, my work replaces the discrete summation over integer orders with a continuous-order integral over r and studies the resulting sum--integral discrepancy via the Euler--Maclaurin formula. Thus, while conceptually adjacent in its use of fractional Taylor structures, this paper does not overlap with the continuous-order reconstruction operator introduced here.

@misc{Gladkina2017,
  author  = {Gladkina, A. and Shchedrin, G. and {Al Khawaja}, U. and Carr, L. D.},
  title   = {Expansion of fractional derivatives in terms of an integer derivative series: Physical and numerical applications},
  year    = {2017},
  note    = {Preprint, Version 2. arXiv:1710.06297.},
  eprint  = {1710.06297},
  archivePrefix = {arXiv},
  doi     = {10.48550/arXiv.1710.06297}
}
% Anastasia Gladkina, Gavriil Shchedrin, U. Al Khawaja, and Lincoln D. Carr derive infinite series expansions that express a fractional derivative of fixed order as a series of integer-order derivatives, with coefficients depending on the fractional order. These expansions are intended to facilitate numerical evaluation of fractional derivatives and the solution of fractional differential equations. Although this work involves infinite series and fractional operators, it focuses on expanding a given fractional derivative rather than reconstructing a function from derivatives of all orders. My work differs by integrating fractional derivatives over a continuum of orders to define a Maclaurin-type reconstruction operator for analytic functions.

