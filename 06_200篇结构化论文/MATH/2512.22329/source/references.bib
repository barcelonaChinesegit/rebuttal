@article{Osler1971,
  author  = {Osler, T. J.},
  title   = {Taylor's series generalized for fractional derivatives and applications},
  journal = {SIAM J. Math. Anal.},
  volume  = {2},
  number  = {1},
  pages   = {37--48},
  year    = {1971},
  doi     = {10.1137/0502004}
}
% Thomas J. Osler extends his 1970 fractional Taylor series to a fully general bilateral series indexed from $n = -\infty$ to $\infty$, with general step size $\alpha > 0$ and offset parameter $\gamma$. Theorem 4.1 gives the rigorous contour integral proof of convergence. For $0 < \alpha \leq 1$ the bilateral sum collapses to a one-sided series, which is the specific result invoked in Proposition~3.2 of the present paper to connect the $\alpha$-parameterized Osler sum to the spectral reconstruction operator $\mathcal{S}[e^x]$ in the limit $\alpha \to 0$. The paper also demonstrates applications to generating functions for special functions of mathematical physics via fractional derivative representations.

